APP_ENV=development
API_PORT=7302

DATABASE_URL=postgresql+asyncpg://retouch:retouch_dev@localhost:7311/retouch
REDIS_URL=redis://localhost:7312

S3_ENDPOINT=http://localhost:7313
# 浏览器访问签名 URL 用的地址（对外域名）。留空则回退到 http://localhost:7313，仅本机可用。
# 公网部署必须设置，否则图片链接指向 localhost、外网打不开。换域名只改这一行。
S3_PUBLIC_ENDPOINT=
S3_ACCESS_KEY=retouch
S3_SECRET_KEY=retouch_dev
S3_BUCKET=retouch
S3_URL_TTL=900

# 生产环境必须替换为随机值
JWT_SECRET=dev-only-secret-please-change-in-production
JWT_TTL_HOURS=24

# mock 只在本地开发可用；公网部署必须用 APP_ENV=production 且 IMAGE_PROVIDER=dashscope
IMAGE_PROVIDER=mock
# 可改为业务空间专属域名 https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com
# 用户没填模型名时的默认值，同时用于设置面板预填
TEXT_TO_IMAGE_MODEL=qwen-image-3.0
IMAGE_EDIT_MODEL=wan2.7-image-pro
PLANNER_MODEL=qwen3.7-flash

# 用户模型 Key 的加密主密钥（Fernet），API 与 Worker 必须一致；留空则无法保存或使用用户 Key
# 生成：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=
# 是否允许未配置 Key 的访客回退使用平台 Key。公网部署务必保持 false
ALLOW_PLATFORM_KEY_FALLBACK=false
# 仅当 ALLOW_PLATFORM_KEY_FALLBACK=true 时才会被使用
DASHSCOPE_API_KEY=
# auto 优先 rembg，corner 仅四角抠图
MATTING_PROVIDER=auto
# rembg 权重名；小内存机器用 isnet-general-use（约 180MB），bria-rmbg 需 8GB 以上内存
MATTING_MODEL=isnet-general-use
# auto 有 rapidocr 则拆出文字层，none 跳过
OCR_PROVIDER=auto
